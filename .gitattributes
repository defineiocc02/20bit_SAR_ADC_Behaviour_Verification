# 工程源码和一般文本以 LF 检出。
* text=auto eol=lf
*.py text eol=lf
*.sv text eol=lf
*.svh text eol=lf
*.v text eol=lf
*.sh text eol=lf
*.tcl text eol=lf
*.sdc text eol=lf
*.mk text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.png binary
*.pdf binary
*.npz binary
*.zip binary
*.gds binary

# 保留仿真日志、CSV 和自绘 SVG 的生成字节，供 SHA-256 清单复核。
task1/evidence/rtl/*.log -text whitespace=-blank-at-eol
task1/evidence/bridge_rtl/*.log -text whitespace=-blank-at-eol
task1/evidence/**/*.csv -text whitespace=cr-at-eol
task1/evidence/**/*.svg -text whitespace=-blank-at-eol
# 模块二的图与实验表保持绘图及采集时的字节，供摘要核验。
task2/figures/*.svg -text whitespace=-blank-at-eol
task2/evidence/**/*.svg -text whitespace=-blank-at-eol
task2/evidence/**/*.csv -text whitespace=cr-at-eol
task2/evidence/dither_rng/*.log -text whitespace=-blank-at-eol
task2/eight_rtl/evidence/*.log -text whitespace=-blank-at-eol
