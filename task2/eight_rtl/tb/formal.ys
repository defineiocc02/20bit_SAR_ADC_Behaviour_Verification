# 在仓库根运行；Ubuntu Noble Yosys 0.33，时间 1 同步复位。
# 该前端直接生成 $assert；不支持新版本的 chformal -lower。
# SAT 前必须确认断言非空，防止无属性设计被误判通过。
read_verilog -sv -formal task1/rtl/slice_scheduler.sv task1/rtl/fig11_dem.sv task1/rtl/module1_top.sv task1/rtl/fig21_bridge.sv task1/rtl/module1_bridge_top.sv task2/rtl/dither_word_gen.sv task2/eight_rtl/rtl/dither8_top.sv task2/eight_rtl/tb/dither8_contract.sv
prep -top dither8_contract -flatten
opt
select -assert-any t:$assert
sat -seq 7 -set-at 1 rst_ni 0 -set-def-inputs -prove-asserts -timeout 45 -verify
