# =============================================================================
# 文件名     : prove_edge_words.ys
# 模块名     : ad4080_ddr_edge_words
# 版本       : v1.0
# 功能       : 检查通用综合无状态，然后证明综合网表的边沿排列。
# 设计说明   : 证明器按主机接线拼接，证明输入样本、lane 和检查位全开放。
# -----------------------------------------------------------------------------
# 变更记录
# -----------------------------------------------------------------------------
# 初始版本，暂无变更记录。
# =============================================================================

# =============================================================================
# 1. 通用综合，不加载目标 Liberty
# =============================================================================
read_verilog -sv ad4080_ddr_edge_words.sv
synth -noabc -top ad4080_ddr_edge_words
check -assert
select -assert-none t:$*dff* t:$*latch* t:$_*DFF* t:$_*LATCH* t:$sr t:$_SR_* t:$mem*
stat

# =============================================================================
# 2. 在实际通用综合网表上求证
# =============================================================================
# 保留上一节的 DUT 实例，避免仅证明未经综合的源码拓扑。
read_verilog -sv ad4080_ddr_edge_words_properties.sv
hierarchy -check -top ad4080_ddr_edge_words_properties
proc
flatten
opt_clean
sat -verify -set-def-inputs -prove correct_o 1 -show-inputs -show-outputs
