  "figure_purposes": {
    "dither-transfer": {
      "zh": "\u5206\u8def\u6ce8\u5165\u6270\u52a8\uff0c\u518d\u6309\u540c\u7b14\u6743\u91cd\u6263\u56de\u3002",
      "en": "Split the dither and cancel it with the sampled weights."
    },
    "integer-arithmetic": {
      "zh": "\u6309\u5b9e\u9645\u7535\u5bb9\u6743\u91cd\u4fee\u6b63\u5931\u914d\uff0c\u6539\u5584\u7ebf\u6027\u5ea6\u3002",
      "en": "Correct mismatch using the physical cell weights."
    },
    "physical-masks": {
      "zh": "\u8f6e\u6362\u7b49\u6743\u7535\u5bb9\uff0c\u51cf\u8f7b\u5931\u914d\u9020\u6210\u7684\u975e\u7ebf\u6027\u3002",
      "en": "Rotate equal-weight cells to spread mismatch."
    },
    "sar-events": {
      "zh": "\u53ea\u5199\u5df2\u51b3\u4f4d\uff0c\u9632\u6b62\u8bd5\u63a2\u6270\u52a8\u4f59\u5dee\u3002",
      "en": "Write resolved decisions and suppress rejected trials."
    },
    "capture-handover": {
      "zh": "\u4ea4\u9519\u91c7\u6837\u5e76\u6309\u6807\u7b7e\u914d\u5bf9\uff0c\u4fdd\u6301\u8fde\u7eed\u51fa\u7801\u3002",
      "en": "Interleave samples and match returning codes by tag."
    },
    "slice-allocation": {
      "zh": "\u8f6e\u6362\u91c7\u96c6\u4e0e\u8f6c\u6362\u7247\u7ec4\uff0c\u5206\u644a\u5668\u4ef6\u4f7f\u7528\u3002",
      "en": "Rotate slice roles to distribute usage."
    },
    "linearity": {
      "zh": "\u6309\u7269\u7406\u6743\u91cd\u8865\u507f\u5931\u914d\uff0c\u6539\u5584INL\u4e0eDNL\u3002",
      "en": "Correct cell mismatch to improve static linearity."
    },
    "effects": {
      "zh": "\u5206\u5f00\u5207\u6362\u6270\u52a8\u4e0e\u6821\u6b63\uff0c\u8bc6\u522b\u5404\u81ea\u7684\u7ebf\u6027\u5ea6\u6536\u76ca\u3002",
      "en": "Isolate switching and weight effects within each condition."
    }
  },
